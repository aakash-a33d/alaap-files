# Privacy Gateway
#
# Copy to .env for local development. No production secret ever lives in this file
# or in any developer's working tree (§12P, backend-requirements §6 — production key
# material comes from OpenBao and exists in no other environment).

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Repository root, used to load metadata/. Resolved relative to the gateway package
# when unset, so this is only needed if the gateway runs outside the monorepo.
# METADATA_ROOT=../..

# Sessions live here and nowhere else. Redis loss logs everyone out; that is correct
# behaviour and must not be "fixed" with a fallback that weakens revocation
# (backend-requirements §5).
REDIS_URL=redis://:dev_redis_c93f5a17e0b846d2@127.0.0.1:6379

# Audit vault. The gateway's role holds INSERT on audit_events and nothing else —
# no SELECT, no UPDATE, no DELETE, in any environment.
AUDIT_DATABASE_URL=postgres://gateway_audit:dev_gateway_audit_08b6e42f7d15a9c3@127.0.0.1:5434/audit_vault

# Shared secret for service-to-service request signing. MVP mechanism; mTLS between
# deployables replaces it before production. See ADR-0004 (to be written).
SERVICE_AUTH_SECRET=dev-only-not-a-real-secret-change-me

# Upstream service base URLs. A service absent here cannot be routed to, which is the
# intended failure mode while the services are unbuilt.
UPSTREAM_AUTH_SERVICE=http://127.0.0.1:8101
UPSTREAM_PSEUDONYM_SERVICE=http://127.0.0.1:8102
UPSTREAM_COMMUNITY_SERVICE=http://127.0.0.1:8103
UPSTREAM_MODERATION_SERVICE=http://127.0.0.1:8104
# The AI tier. Loopback only: it is not for a network, and the gateway is the
# only thing that should be able to reach it.
UPSTREAM_AI_ORCHESTRATOR=http://127.0.0.1:8000
UPSTREAM_CONSENT_SERVICE=http://127.0.0.1:8105
UPSTREAM_CLINICAL_VAULT_SERVICE=http://127.0.0.1:8106
UPSTREAM_CARE_THERAPY_SERVICE=http://127.0.0.1:8107
UPSTREAM_THERAPIST_SERVICE=http://127.0.0.1:8108
UPSTREAM_BILLING_SUBSIDY_SERVICE=http://127.0.0.1:8109
UPSTREAM_SAFETY_CRISIS_SERVICE=http://127.0.0.1:8110
UPSTREAM_NOTIFICATION_SERVICE=http://127.0.0.1:8111
UPSTREAM_RETENTION_SERVICE=http://127.0.0.1:8112
UPSTREAM_ADMIN_SERVICE=http://127.0.0.1:8113
UPSTREAM_PARTNER_SERVICE=http://127.0.0.1:8114

# identity-isolate deployable — separate network segment in production.
UPSTREAM_BREAK_GLASS_SERVICE=http://127.0.0.1:8201

# Anti-abuse rate limiting. NOT plan quota — quota is an entitlement decision and
# belongs to the service that owns the content (metadata/catalog/plans/).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_AUTHENTICATED=120
RATE_LIMIT_MAX_ANONYMOUS=20

# Session lifetimes are enforced by auth-service when it mints a session; the gateway
# only honours what the record says. This is the ceiling it will accept.
SESSION_MAX_ABSOLUTE_HOURS=720
