# auth-service — development only. No production secret lives here (§12P).
NODE_ENV=development
PORT=8101
LOG_LEVEL=debug

CORE_DATABASE_URL=postgres://auth_service_app:dev_auth_1d4b7f2e9a63c085@127.0.0.1:5432/core
AUDIT_DATABASE_URL=postgres://auth_service_audit:dev_auth_audit_3e97b1d504a86f2c@127.0.0.1:5434/audit_vault
REDIS_URL=redis://:dev_redis_c93f5a17e0b846d2@127.0.0.1:6379

# Must match the gateway's, and pseudonym-service's.
SERVICE_AUTH_SECRET=dev-only-not-a-real-secret-change-me
UPSTREAM_PSEUDONYM_SERVICE=http://127.0.0.1:8102

# Blind-index pepper. MUST be identical to identity-vault-service's, or the two
# instances cannot reconcile an account without one learning the number.
# Rotating this re-indexes every account, so it is a planned operation.
MOBILE_PEPPER=dev-only-mobile-pepper-0f3a91c47b2e8d0651ae
# Rotatable freely — challenges live five minutes.
OTP_PEPPER=dev-only-otp-pepper-7e14bd6239a05c8641bf
DEVICE_PEPPER=dev_device_pepper_4f81a20c7e63b95d

# `log` prints the code instead of sending it. TRAI DLT registration gates real SMS
# and takes weeks. env.ts refuses this value when NODE_ENV=production.
OTP_TRANSPORT=log

# WebAuthn. RP_ID is the registrable domain, never the full origin; EXPECTED_ORIGIN
# must match what the browser sends, character for character.
RP_NAME=Alaap
RP_ID=localhost
EXPECTED_ORIGIN=http://localhost:5173
