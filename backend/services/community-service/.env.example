NODE_ENV=development
PORT=8103
LOG_LEVEL=info

# community_vault. Posts, replies, reports, restrictions. This service can read
# personas but never write one, and holds no credential on any other vault.
COMMUNITY_DATABASE_URL=postgres://community_service_app:REPLACE_ME@127.0.0.1:5432/community_vault

# Separate credential on the audit instance. Append only.
AUDIT_DATABASE_URL=postgres://community_service_audit:REPLACE_ME@127.0.0.1:5434/audit_vault

# The AI tier, for moderating replies. Loopback: this service calls
# /v1/moderate/internal, which has no gateway path and is not for a network.
UPSTREAM_AI_ORCHESTRATOR=http://127.0.0.1:8000

# Verifies the gateway's signature, and signs this service's calls to the AI tier.
SERVICE_AUTH_SECRET=REPLACE_ME

# Expired-post sweep, in seconds. 0 disables it. The sweep changes state; the feed
# filters on expires_at independently, so a post vanishes the moment it expires
# however long this interval is.
EXPIRY_SWEEP_SECONDS=300
UPSTREAM_MODERATION_SERVICE=http://127.0.0.1:8104
RESPONSE_WORKER_SECONDS=5
