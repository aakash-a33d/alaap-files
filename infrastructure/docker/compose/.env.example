# Local development stack.
#
# Copy to .env in this directory. These are DEVELOPMENT values only.
#
# No production secret ever lives in this file, in any developer's working tree, or
# in any environment other than the one it belongs to (§12P). Production credentials
# come from OpenBao and exist nowhere else — backend-requirements §6.
#
# .env is gitignored. If you find yourself about to commit one, stop.

# ---------------------------------------------------------------- ports ------
# All published to 127.0.0.1 only, never 0.0.0.0. Nothing here should be reachable
# from your network, let alone the internet.
POSTGRES_SHARED_PORT=5432
POSTGRES_IDENTITY_PORT=5433
POSTGRES_AUDIT_PORT=5434
REDIS_PORT=6379
OPENBAO_PORT=8200

# ---------------------------------------------- instance superusers ----------
# Different per instance, deliberately. Reusing one password across all three would
# undo the containment the instance split exists to provide.
POSTGRES_SHARED_PASSWORD=dev_shared_5f3a91c47b2e8d06
POSTGRES_IDENTITY_PASSWORD=dev_identity_a82c604fe17b93d5
POSTGRES_AUDIT_PASSWORD=dev_audit_7e14bd6239a05c86

REDIS_PASSWORD=dev_redis_c93f5a17e0b846d2
OPENBAO_ROOT_TOKEN=dev-root-token-not-for-any-real-environment

# ------------------------------------------- service login roles -------------
# Created by scripts/db/migrate.mjs, which refuses anything under 16 characters.
#
# Note the split: a service that owns tables gets a role on its vault instance AND a
# separate role on the audit instance. The gateway appears only on audit, because
# audit append is its single database credential — it owns no tables anywhere.

# shared instance
AUTH_SERVICE_DB_PASSWORD=dev_auth_1d4b7f2e9a63c085
PSEUDONYM_SERVICE_DB_PASSWORD=dev_pseudo_6c02e8b5f39d417a
COMMUNITY_SERVICE_DB_PASSWORD=dev_community_9a7e35c81b0f6d24
MODERATION_SERVICE_DB_PASSWORD=dev_moderation_4f81a06d2e59b7c3

# audit instance
GATEWAY_AUDIT_DB_PASSWORD=dev_gateway_audit_08b6e42f7d15a9c3
AUTH_SERVICE_AUDIT_DB_PASSWORD=dev_auth_audit_3e97b1d504a86f2c
PSEUDONYM_SERVICE_AUDIT_DB_PASSWORD=dev_pseudo_audit_b25f8c390d6e14a7
COMMUNITY_SERVICE_AUDIT_DB_PASSWORD=dev_comm_audit_7a3d5e19c284fb60
MODERATION_SERVICE_AUDIT_DB_PASSWORD=dev_mod_audit_c4813a7d06e2f915
AUDIT_SERVICE_DB_PASSWORD=dev_audit_svc_5b2e903a7f81c64d

# clinical, billing and identity vaults (M1)
CLINICAL_VAULT_SERVICE_DB_PASSWORD=dev_clinical_2f8a61d0934bc7e5
CONSENT_SERVICE_DB_PASSWORD=dev_consent_7b93e105ca4f8d26
